---
import { client } from "../lib/sanity";

// Traemos las 5 noticias con más clics
const trendingPosts = await client.fetch(`
  *[_type == "posts" && defined(slug.current)] | order(views desc)[0..4] {
    _id,
    title,
    "slug": slug.current,
    views
    }
`);
---

<div class="sidebar-widget">
    <div class="widget-title"><span class="dot">•</span> TRENDING NOW</div>
    {trendingPosts.map((post: any, index: number) => (
    <div class="trending-item">
    <!-- Genera el número 01, 02, etc. automáticamente -->
        <div class="trending-num">
            {String(index + 1).padStart(2, '0')}
        </div>
        <div class="trending-text">
            <a href={`/${post.slug}`} class="trending-link">
                {post.title}
            </a>
        </div>
    </div>
    ))}
</div>

<style>
    .trending-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
    }

    .trending-link:hover {
    color: #00d2ff;
    }
</style>