---
import youtubeIcon from "../assets/socials/YoutubeLogo.png";
import telegramIcon from "../assets/socials/500px-Telegram.png";
import xIcon from "../assets/socials/XLogo.png";
---

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo" style="margin-bottom:12px;">
          <span class="logo-w">Weyalu</span><span class="logo-accent"
            >series</span
          >
        </div>
        <p>
          Your daily source for TV series analysis, anime deep dives, tech
          reviews, and the best streaming deals on the internet. Made by fans,
          for fans.
        </p>
        <div class="footer-socials">
          <a
            class="social-btn"
            href="https://www.youtube.com/@Weyaluseries"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={youtubeIcon.src} />
          </a>
          <a
            class="social-btn"
            href="https://t.me/+S3HcB1or8LQ2ZjQ0#"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={telegramIcon.src} />
          </a>
          <a
            class="social-btn"
            href="https://x.com/Weyaluseries"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={xIcon.src} />
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Categories</h4>
        <ul>
          <li><a href="/category/series">Series News</a></li>
          <li><a href="/category/anime">Anime</a></li>
          <li><a href="/category/movies">Movies</a></li>
          <li><a href="/category/tech">Tech Reviews</a></li>
          <li><a href="/category/theories">Theories & Lore</a></li>
          <li><a href="#">Deals</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/legal/contact">Contact</a></li>
          <li><a href="/legal/privacy-policy">Privacy Policy</a></li>
          <li><a href="/legal/terms">Terms of Use</a></li>
          <li>
            <a href="/legal/affiliate-disclosure">Affiliate Disclosure</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © 2026 <span>Weyaluseries</span>. All rights reserved. We may earn a
        commission from affiliate links.
      </p>
      <p>built with love &lt;3</p>
    </div>
  </div>
</footer>
