---
// En este widget se implementará la funcionalidad que mostrará las últimas noticias de los canales.
const { channel } = Astro.props

---
<!-- YOUTUBE WIDGET -->
<div class="yt-widget">
    <div class="yt-header">
        <span class="yt-icon">▶</span>
        <span class="yt-header-text">Latest from @{channel}</span>
    </div>
    <div class="yt-thumb">
        <div
            class="img-placeholder"
            style="height:160px; font-size:12px; letter-spacing:2px;"
        >
            YOUTUBE THUMBNAIL
        </div>
        <div class="yt-play">▶</div>
    </div>
    <div class="yt-info">
        <div class="yt-title">
            FROM S4 Episode 7 — Boyd's Plan FAILED. Here's Why.
        </div>
        <div class="yt-channel">@angeluseries · 33K subscribers</div>
    </div>
</div>
