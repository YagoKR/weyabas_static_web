---
import { client } from "../lib/sanity";

// 1. Obtenemos las últimas 5 noticias directamente desde Sanity
const posts = await client.fetch(`
  *[_type == "posts"] | order(date desc)[0..4] {
    _id,
    title,
    "slug": slug.current
  }
`);

interface NewsItem {
  title: string;
  slug: string;
}

// 2. Mapeamos los datos limpios
const latest: NewsItem[] = posts.map((item: any) => ({
  title: item.title,
  slug: item.slug,
}));

// 3. Duplicamos la lista para crear el efecto de marquee/scroll infinito sin saltos
const doubled = [...latest, ...latest];
---

<div class="breaking-bar">
  <div class="breaking-scroll">
    {
      doubled.map((item) => (
        <a href={`/${item.slug}`} class="breaking-item">
          <span>●</span> {item.title}
        </a>
      ))
    }
  </div>
</div>
