---
// Main.astro

/* 
    El componente Main.astro integra la mayor parte de los distintos componentes de la página principal.
*/

// IMPORT
import { client } from "../lib/sanity";
import { getReadingTime } from "../utils/readingTime";
import { naturalDate } from "../utils/naturalDate";
import { urlFor } from "../utils/urlFor";
import YoutubeWG from "./WidgetYoutube.astro";
import DealsWG from "./WidgetDeals.astro";
import TelegramWG from "./WidgetTelegram.astro";
import Trending from "./Trending.astro";
import Deals from "./Deals.astro";

/*
 * posts: se piden los posts a Sanity mediante un query GROQ. Estos se devuelven organizados en orden descendiente.
 */
const posts = await client.fetch(`
  *[_type == "posts" && defined(slug.current)] | order(date desc)
`);

/*
 * heroPosts: selecciona los tres artículos más recientes para colocar en el hero.
 */
const heroPosts = posts.slice(0, 3);
/*
 * mainPost: variable que contiene el post más reciente.
 * secondaryPost1: variable que contiene el segundo post mas reciente.
 * SecondaryPost2: variable que contiene el tercer post más reciente.
 */
const [mainPost, secondaryPost1, secondaryPost2] = heroPosts;

/*
 * latestNews: selecciona los artículos más recientes excluyendo aquellos incluidos en el hero. No se discrimina en base a categoría.
 */
const latestNews = posts.slice(3, 9);
// Fetch latest 4 'series' posts
const seriesPosts = await client.fetch(`
  *[_type == "posts" && "series" in categories] | order(date desc)[0..3] {
    _id,
    title,
    slug,
    date,
    summary,
    content,
    image,
    categories
  }
`);

// Fetch latest 4 'anime' posts
const animePosts = await client.fetch(`
  *[_type == "posts" && "anime" in categories] | order(date desc)[0..3] {
    _id,
    title,
    slug,
    date,
    summary,
    content,
    image,
    categories
  }
`);
console.log(secondaryPost1.categories);
---

<!-- MAIN -->
<main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <!-- HERO MAIN -->
        <div class="hero-main">
          <a
            href={`/${mainPost?.slug?.current || mainPost?.slug}`}
            class="img-placeholder hero-main-img"
          >
            {
              mainPost?.image ? (
                <img
                  src={urlFor(mainPost.image).auto("format").url()}
                  alt={mainPost.image.alt || mainPost.title}
                  loading="lazy"
                />
              ) : (
                <span>{mainPost?.title}</span>
              )
            }
          </a>
          <div class="hero-main-content">
            <span
              class={`tag tag-${Array.isArray(mainPost?.categories) ? mainPost.categories[0] : mainPost?.categories || "news"}`}
            >
              {
                Array.isArray(mainPost?.categories)
                  ? mainPost.categories[0]
                  : mainPost?.categories || "news"
              }
            </span>
            <a href={`/${mainPost?.slug?.current || mainPost?.slug}`}>
              <h1 class="hero-title">{mainPost?.title}</h1>
            </a>
            <div class="hero-meta">
              <span
                >by <strong style="color:#fff">{mainPost?.author}</strong></span
              >
              <span class="dot">◆</span>
              <span>{naturalDate(mainPost?.date)}</span>
              <span class="dot">◆</span>
              <span>{getReadingTime(mainPost?.content)} min read</span>
            </div>
          </div>
        </div>

        <!-- HERO SECONDARY 1 -->
        {
          secondaryPost1 && (
            <div class="hero-secondary">
              <a
                href={`/${secondaryPost1.slug?.current || secondaryPost1.slug}`}
                class="hero-secondary-img"
              >
                {secondaryPost1.image ? (
                  <img
                    src={urlFor(secondaryPost1.image).auto("format").url()}
                    alt={secondaryPost1.image.alt || secondaryPost1.title}
                    loading="lazy"
                  />
                ) : (
                  <span>{secondaryPost1.title}</span>
                )}
              </a>
              <span
                class={`tag tag-${Array.isArray(secondaryPost1.categories) ? secondaryPost1.categories[0] : secondaryPost1.categories || "news"}`}
              >
                {Array.isArray(secondaryPost1.categories)
                  ? secondaryPost1.categories[0]
                  : secondaryPost1.categories || "news"}
              </span>
              <a
                href={`/${secondaryPost1.slug?.current || secondaryPost1.slug}`}
              >
                <div class="secondary-title">{secondaryPost1.title}</div>
              </a>
              <div class="card-meta">
                <span>{naturalDate(secondaryPost1.date)}</span>
                <span>{getReadingTime(secondaryPost1.content)} min read</span>
              </div>
            </div>
          )
        }

        <!-- HERO SECONDARY 2 -->
        {
          secondaryPost2 && (
            <div class="hero-secondary">
              <a
                href={`/${secondaryPost2.slug?.current || secondaryPost2.slug}`}
                class="hero-secondary-img"
              >
                {secondaryPost2.image ? (
                  <img
                    src={urlFor(secondaryPost2.image).auto("format").url()}
                    alt={secondaryPost2.image.alt || secondaryPost2.title}
                    loading="lazy"
                  />
                ) : (
                  <span>{secondaryPost2.title}</span>
                )}
              </a>
              <span
                class={`tag tag-${Array.isArray(secondaryPost2.categories) ? secondaryPost2.categories[0] : secondaryPost2.categories || "news"}`}
              >
                {Array.isArray(secondaryPost2.categories)
                  ? secondaryPost2.categories[0]
                  : secondaryPost2.categories || "news"}
              </span>
              <a
                href={`/${secondaryPost2.slug?.current || secondaryPost2.slug}`}
              >
                <div class="secondary-title">{secondaryPost2.title}</div>
              </a>
              <div class="card-meta">
                <span>{naturalDate(secondaryPost2.date)}</span>
                <span>{getReadingTime(secondaryPost2.content)} min read</span>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /HERO -->

  <!-- AD SLOT TOP -->
  <div class="container">
    <div class="ad-slot"><span>Advertisement</span></div>
  </div>

  <!-- MAIN CONTENT LAYOUT -->
  <div class="container">
    <div class="content-layout">
      <!-- LEFT COLUMN (Main Column) -->
      <div class="main-col">
        <!-- LATEST NEWS -->
        <div class="section-header">
          <div class="section-neon-dot"></div>
          <h2 class="section-title">Latest News</h2>
          <div class="section-line"></div>
          <a href="/blog" class="section-more">All News →</a>
        </div>

        <div class="card-grid">
          {
            latestNews &&
              latestNews.map((post: any) => {
                const cat = Array.isArray(post.categories)
                  ? post.categories[0]
                  : post.categories || "news";
                const slugUrl = post.slug?.current || post.slug;

                return (
                  <div class="card">
                    <a href={`/${slugUrl}`} class="card-img">
                      {post.image ? (
                        <img
                          src={urlFor(post.image).auto("format").url()}
                          alt={post.image.alt || post.title}
                          loading="lazy"
                        />
                      ) : (
                        <span>{post.title}</span>
                      )}
                    </a>
                    <div class="card-body">
                      <span class={`tag tag-${cat}`}>{cat}</span>
                      <a href={`/${slugUrl}`}>
                        <div class="card-title">{post.title}</div>
                      </a>
                      <div class="card-excerpt">{post.summary}</div>
                      <div class="card-meta">
                        <span>{naturalDate(post.date)}</span>
                        <span>{getReadingTime(post.content)} min read</span>
                      </div>
                    </div>
                  </div>
                );
              })
          }
        </div>

        <!-- AD SLOT MIDDLE -->
        <div class="ad-slot">
          <span>Advertisement</span>
        </div>

        <!-- SERIES SECTION -->
        <div class="section-header">
          <div class="section-neon-dot"></div>
          <h2 class="section-title">Series Deep Dives</h2>
          <div class="section-line"></div>
          <a href="/category/series" class="section-more">All Series →</a>
        </div>

        <div class="horizontal-scroll">
          {
            seriesPosts && seriesPosts.length > 0 ? (
              seriesPosts.map((post: any) => {
                const cat = Array.isArray(post.categories)
                  ? post.categories[0]
                  : post.categories || "series";
                const slugUrl = post.slug?.current || post.slug;

                return (
                  <div class="card">
                    <a href={`/${slugUrl}`} class="card-img-link">
                      {post.image ? (
                        <img
                          src={urlFor(post.image)
                            .width(400)
                            .height(225)
                            .auto("format")
                            .url()}
                          alt={post.image.alt || post.title}
                          class="card-img"
                          loading="lazy"
                        />
                      ) : (
                        <div class="img-placeholder card-img">SERIES</div>
                      )}
                    </a>
                    <div class="card-body">
                      <span class={`tag tag-${cat}`}>{cat}</span>
                      <a href={`/${slugUrl}`}>
                        <div class="card-title">{post.title}</div>
                      </a>
                      <div class="card-meta">
                        <span>{naturalDate(post.date)}</span>
                        <span>{getReadingTime(post.content)} min read</span>
                      </div>
                    </div>
                  </div>
                );
              })
            ) : (
              <p class="no-posts">No series posts available yet.</p>
            )
          }
        </div>

        <!-- ANIME SECTION -->
        <div class="section-header" style="margin-top:40px;">
          <div
            class="section-neon-dot"
            style="background:var(--purple); box-shadow: 0 0 18px #aa55ff99;"
          >
          </div>
          <h2 class="section-title" style="color:var(--purple);">Anime</h2>
          <div
            class="section-line"
            style="background:linear-gradient(to right, var(--purple), transparent);"
          >
          </div>
          <a
            href="/category/anime"
            class="section-more"
            style="color:var(--purple); border-color:#6633aa;"
          >
            All Anime →
          </a>
        </div>

        <div class="horizontal-scroll">
          {
            animePosts && animePosts.length > 0 ? (
              animePosts.map((post: any) => {
                const cat = Array.isArray(post.categories)
                  ? post.categories[0]
                  : post.categories || "anime";
                const slugUrl = post.slug?.current || post.slug;

                return (
                  <div class="card">
                    <a href={`/${slugUrl}`} class="card-img-link">
                      {post.image ? (
                        <img
                          src={urlFor(post.image)
                            .width(400)
                            .height(225)
                            .auto("format")
                            .url()}
                          alt={post.image.alt || post.title}
                          class="card-img"
                          loading="lazy"
                        />
                      ) : (
                        <div class="img-placeholder card-img">ANIME</div>
                      )}
                    </a>
                    <div class="card-body">
                      <span class={`tag tag-${cat}`}>{cat}</span>
                      <a href={`/${slugUrl}`}>
                        <div class="card-title">{post.title}</div>
                      </a>
                      <div class="card-meta">
                        <span>{naturalDate(post.date)}</span>
                        <span>{getReadingTime(post.content)} min read</span>
                      </div>
                    </div>
                  </div>
                );
              })
            ) : (
              <p class="no-posts">No anime posts available yet.</p>
            )
          }
        </div>
      </div>
      <!-- /main-col (CIERRA CORRECTAMENTE LA COLUMNA IZQUIERDA AQUÍ) -->

      <!-- RIGHT COLUMN (Sidebar) -->
      <aside class="sidebar">
        <TelegramWG telegramUrl="https://t.me/+S3HcB1or8LQ2ZjQ0" />
        <Trending />
        <YoutubeWG
          channel="angeluseries"
          channelId="UCuuBBKR7pif5qztO911Jzmg"
        />
        <YoutubeWG channel="weyabu" channelId="UCNfVcg3KfUq4c_WA529qWZg" />
        <DealsWG />
      </aside>
    </div>
  </div>

  <Deals />
</main>
