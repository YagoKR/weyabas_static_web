---
// /src/components/Main.astro

/* 
    El componente Main.astro integra la mayor parte de los distintos componentes de la página principal.
*/

//import { sanityClient } from "../lib/sanity";
import { client } from '../lib/sanity';
import { getReadingTime } from '../utils/readingTime'
import { sortPosts } from '../utils/sortPosts'
import YoutubeWG from './WidgetYoutube.astro'
import DealsWG from './WidgetDeals.astro'
import TelegramWG from './WidgetTelegram.astro'
import Trending from './Trending.astro'
import Deals from './Deals.astro'

// Buscar todos los posts y usar la funcion sortPosts() para que se organizen de mas recientes a mas antiguos.
const posts = await client.fetch(`
  *[_type == "posts" && defined(slug.current)] | order(date desc)
`);
// Los tres articulos más recientes se ubican en el hero
const heroPosts = posts.slice(0, 3);
const [mainPost, secondaryPost1, secondaryPost2] = heroPosts;

---
<!-- MAIN -->
<main>
    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                <!-- HERO MAIN -->
                <div class="hero-main">
                    <a href={`/${mainPost.slug.current}`} class="img-placeholder hero-main-img" style="height:520px; font-size:14px; color:#1e2e3e; letter-spacing:3px;">
                        FROM S4 HERO IMAGE
                    </a>
                    <div class="hero-main-content">
                        <span class="tag tag-series">{mainPost.categories?.[0]}</span>
                        <a href={`/${mainPost.slug.current}`}><h1 class="hero-title">{mainPost.title}</h1></a>
                        <div class="hero-meta">
                            <span
                                >by <strong style="color:#fff">Angel</strong
                                ></span
                            >
                            <span class="dot">◆</span>
                            <span>{mainPost.date}</span>
                            <span class="dot">◆</span>
                            <span>XXX min read</span>
                            <span class="dot">◆</span>
                            <span style="color:var(--neon)">MGM+</span>
                        </div>
                    </div>
                </div>

                <!-- HERO SECONDARY 1 -->
                {secondaryPost1 && (
                <div class="hero-secondary">
                    <a href={`/${secondaryPost1.slug.current}`} class="img-placeholder hero-secondary-img">ANIME</a>
                    <span class="tag tag-anime">{secondaryPost1.categories?.[0]}</span>
                    <a href={`/${secondaryPost1.slug.current}`}><div class="secondary-title">{secondaryPost1.title}</div></a>
                    <div class="card-meta">
                        <span>{secondaryPost1.date}</span>
                        <span>XXX min read</span>
                    </div>
                </div>
                )}

                <!-- HERO SECONDARY 2 -->
                {secondaryPost2 && (
                <div class="hero-secondary">
                    <a href={`/${secondaryPost2.slug.current}`} class="img-placeholder hero-secondary-img">TECH</a>
                    <span class="tag tag-tech">{secondaryPost2.categories?.[0]}</span>
                    <a href={`/${secondaryPost2.slug.current}`}><div class="secondary-title">{secondaryPost2.title}</div></a>
                    <div class="card-meta">
                        <span>{secondaryPost2.date}</span>
                        <span>XXX min read</span>
                    </div>
                </div>
                )}
            </div>
        </div>
    </section>
    
    <!-- AD SLOT -->
    <div class="container">
        <div class="ad-slot"><span>Advertisement</span></div>
    </div>

    <!-- LATEST NEWS + SIDEBAR -->
    <div class="container">
        <div class="content-layout">
            <div class="main-col">
                <!-- LATEST NEWS -->
                <div class="section-header">
                    <div class="section-neon-dot"></div>
                    <h2 class="section-title">Latest News</h2>
                    <div class="section-line"></div>
                    <a href="#" class="section-more">All News →</a>
                </div>

                <div class="card-grid">
                    <div class="card">
                        <div class="img-placeholder card-img">FROM</div>
                        <div class="card-body">
                            <span class="tag tag-series">Series</span>
                            <div class="card-title">
                                Roger Is No Longer Human — What the Man in
                                Yellow Did to Him Changes Everything
                            </div>
                            <div class="card-excerpt">
                                The Colony House attack at the end of Episode 7
                                wasn't just horror. It was a message from the
                                entity controlling the town.
                            </div>
                            <div class="card-meta">
                                <span>June 9</span><span>5 min</span>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="img-placeholder card-img">ATLA</div>
                        <div class="card-body">
                            <span class="tag tag-series">Series</span>
                            <div class="card-title">
                                Avatar Live-Action Season 2: Why Toph Is the
                                Character That Will Make or Break This Show
                            </div>
                            <div class="card-excerpt">
                                Netflix finally revealed the actor playing Toph,
                                and the fandom is already divided. Here's why
                                the casting matters so much.
                            </div>
                            <div class="card-meta">
                                <span>June 9</span><span>4 min</span>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="img-placeholder card-img">BEARS</div>
                        <div class="card-body">
                            <span class="tag tag-series">Series</span>
                            <div class="card-title">
                                The Bear Season 5 Is the Final Season — And the
                                Real Reason Will Make You Emotional
                            </div>
                            <div class="card-excerpt">
                                FX just confirmed it. The Bear ends with Season
                                5. The showrunner's statement reveals what this
                                was always building toward.
                            </div>
                            <div class="card-meta">
                                <span>June 8</span><span>3 min</span>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="img-placeholder card-img">SPIDER</div>
                        <div class="card-body">
                            <span class="tag tag-series">Series</span>
                            <div class="card-title">
                                Spider-Noir Season 2: Everything We Know So Far
                                After the Renewal Announcement
                            </div>
                            <div class="card-excerpt">
                                Prime Video made it official. Nicolas Cage
                                returns. Here's every confirmed detail and what
                                the showrunners teased.
                            </div>
                            <div class="card-meta">
                                <span>June 8</span><span>4 min</span>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="img-placeholder card-img">ANIME</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Anime</span>
                            <div class="card-title">
                                Why One Piece's Elbaf Arc Is Already Being
                                Called the Best Arc in the Entire Series
                            </div>
                            <div class="card-excerpt">
                                Fans who read the manga knew this was coming.
                                Now anime-only viewers are experiencing it for
                                the first time — and losing it.
                            </div>
                            <div class="card-meta">
                                <span>June 8</span><span>6 min</span>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="img-placeholder card-img">TECH</div>
                        <div class="card-body">
                            <span class="tag tag-tech">Tech</span>
                            <div class="card-title">
                                Amazon Fire TV Stick 4K vs Roku Ultra 2026:
                                Which Streaming Stick Is Worth Your Money?
                            </div>
                            <div class="card-excerpt">
                                We tested both with Netflix, HBO Max, Disney+,
                                and MGM+. The winner isn't who you'd expect.
                            </div>
                            <div class="card-meta">
                                <span>June 7</span><span>7 min</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- AD SLOT -->
                <div class="ad-slot">
                    <span>Advertisement</span>
                </div>

                <!-- SERIES SECTION -->
                <div class="section-header">
                    <div class="section-neon-dot"></div>
                    <h2 class="section-title">Series Deep Dives</h2>
                    <div class="section-line"></div>
                    <a href="#" class="section-more">All Series →</a>
                </div>
                <div class="horizontal-scroll">
                    <div class="card">
                        <div class="img-placeholder card-img">HOTD</div>
                        <div class="card-body">
                            <span class="tag tag-series"
                                >House of the Dragon</span
                            >
                            <div class="card-title">
                                Every Dragon Confirmed Alive Heading Into Season
                                3 — and Who Controls Each One
                            </div>
                            <div class="card-meta">
                                <span>June 7</span><span>8 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">EUPHO</div>
                        <div class="card-body">
                            <span class="tag tag-series">Euphoria</span>
                            <div class="card-title">
                                Rue's Final Arc in Season 3 Was Hidden in Plain
                                Sight Since Episode One
                            </div>
                            <div class="card-meta">
                                <span>June 6</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">DARE</div>
                        <div class="card-body">
                            <span class="tag tag-series">Daredevil</span>
                            <div class="card-title">
                                Why Kingpin's Return in Born Again Changes
                                Everything We Thought We Knew
                            </div>
                            <div class="card-meta">
                                <span>June 5</span><span>6 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">BOYS</div>
                        <div class="card-body">
                            <span class="tag tag-series">The Boys</span>
                            <div class="card-title">
                                The Boys Season 5: Is This Really the End of
                                Homelander?
                            </div>
                            <div class="card-meta">
                                <span>June 4</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ANIME SECTION -->
                <div class="section-header" style="margin-top:40px;">
                    <div
                        class="section-neon-dot"
                        style="background:var(--purple); box-shadow: 0 0 18px #aa55ff99;"
                    >
                    </div>
                    <h2 class="section-title" style="color:var(--purple);">
                        Anime
                    </h2>
                    <div
                        class="section-line"
                        style="background:linear-gradient(to right, var(--purple), transparent);"
                    >
                    </div>
                    <a
                        href="#"
                        class="section-more"
                        style="color:var(--purple); border-color:#6633aa;"
                        >All Anime →</a
                    >
                </div>
                <div class="horizontal-scroll">
                    <div class="card">
                        <div class="img-placeholder card-img">JJK</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Jujutsu Kaisen</span>
                            <div class="card-title">
                                The Real Reason Gojo's Death Hit Harder Than Any
                                Other in Shonen History
                            </div>
                            <div class="card-meta">
                                <span>June 7</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">AOT</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Attack on Titan</span>
                            <div class="card-title">
                                Eren's Plan Explained: Why the Rumbling Was
                                Actually the Only Option Left
                            </div>
                            <div class="card-meta">
                                <span>June 6</span><span>7 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">CSM</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Chainsaw Man</span>
                            <div class="card-title">
                                Part 2's Most Disturbing Chapter Yet — and Why
                                It's Actually Genius
                            </div>
                            <div class="card-meta">
                                <span>June 5</span><span>4 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">OP</div>
                        <div class="card-body">
                            <span class="tag tag-anime">One Piece</span>
                            <div class="card-title">
                                Shanks' True Power Level Finally Revealed —
                                Elbaf Delivers the Moment Fans Waited 25 Years
                                For
                            </div>
                            <div class="card-meta">
                                <span>June 4</span><span>6 min</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIDEBAR -->
            <aside class="sidebar">
                <TelegramWG />
                <Trending />
                <YoutubeWG channel="angeluseries" channelId="UCuuBBKR7pif5qztO911Jzmg" />
                <YoutubeWG channel="weyabu" channelId="UCNfVcg3KfUq4c_WA529qWZg" />
                <DealsWG />
            </aside>
        </div>
    </div>
    <Deals />
</main>
