---
// Main.astro

/* 
    El componente Main.astro integra la mayor parte de los distintos componentes de la página principal.
*/

// IMPORT
import { client } from '../lib/sanity';
import { getReadingTime } from '../utils/readingTime'
import { naturalDate } from '../utils/naturalDate'
import { urlFor } from '../utils/urlFor'
import YoutubeWG from './WidgetYoutube.astro'
import DealsWG from './WidgetDeals.astro'
import TelegramWG from './WidgetTelegram.astro'
import Trending from './Trending.astro'
import Deals from './Deals.astro'

/*
* posts: se piden los posts a Sanity mediante un query GROQ. Estos se devuelven organizados en orden descendiente.
*/
const posts = await client.fetch(`
  *[_type == "posts" && defined(slug.current)] | order(date desc)
`);

/*
* heroPosts: selecciona los tres artículos más recientes para colocar en el hero.
*/
const heroPosts = posts.slice(0, 3);
/*
* mainPost: variable que contiene el post más reciente.
* secondaryPost1: variable que contiene el segundo post mas reciente.
* SecondaryPost2: variable que contiene el tercer post más reciente.
*/
const [mainPost, secondaryPost1, secondaryPost2] = heroPosts;

/*
* latestNews: selecciona los artículos más recientes excluyendo aquellos incluidos en el hero. No se discrimina en base a categoría.
*/
const latestNews = posts.slice(3, 9);
---
<!-- MAIN -->
<main>
    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                <!-- HERO MAIN -->
                <div class="hero-main">
                    <a href={`/${mainPost.slug.current}`} class="img-placeholder hero-main-img">
                        {mainPost.image ? (
                            <img 
                            src={urlFor(mainPost.image)
                                // .width(800)
                                // .height(500)
                                .auto('format')
                                .url()
                                } 
                            alt={mainPost.image.alt || mainPost.title}
                            loading="lazy"
                            />
                        ) : (
                            <span>{mainPost.title}</span>
                        )}
                    </a>
                    <div class="hero-main-content">
                        <span class="tag tag-series">{mainPost.categories?.[0]}</span>
                        <a href={`/${mainPost.slug.current}`}><h1 class="hero-title">{mainPost.title}</h1></a>
                        <div class="hero-meta">
                            <span>by <strong style="color:#fff">{mainPost.author}</strong></span>
                            <span class="dot">◆</span>
                            <span>{naturalDate(mainPost.date)}</span>
                            <span class="dot">◆</span>
                            <span>{getReadingTime(mainPost.content)} min read</span>
                            
                            <!-- <span class="dot">◆</span> -->
                            <!-- <span style="color:var(--neon)">MGM+</span> -->
                        </div>
                    </div>
                </div>

                <!-- HERO SECONDARY 1 -->
                {secondaryPost1 && (
                <div class="hero-secondary">
                    <a href={`/${secondaryPost1.slug.current}`} class="img-placeholder hero-secondary-img">
                        {secondaryPost1.image ? (
                            <img 
                            src={urlFor(secondaryPost1.image)
                                // .width(800)
                                // .height(500)
                                .auto('format')
                                .url()
                                } 
                            alt={secondaryPost1.image.alt || secondaryPost1.title}
                            loading="lazy"
                            />
                        ) : (
                            <span>{secondaryPost1.title}</span>
                        )}
                    </a>
                    <span class="tag tag-anime">{secondaryPost1.categories?.[0]}</span>
                    <a href={`/${secondaryPost1.slug.current}`}><div class="secondary-title">{secondaryPost1.title}</div></a>
                    <div class="card-meta">
                        <span>{naturalDate(secondaryPost1.date)}</span>
                        <span>{getReadingTime(secondaryPost1.content)} min read</span>
                    </div>
                </div>
                )}

                <!-- HERO SECONDARY 2 -->
                {secondaryPost2 && (
                <div class="hero-secondary">
                    <a href={`/${secondaryPost2.slug.current}`} class="img-placeholder hero-secondary-img">
                        {secondaryPost2.image ? (
                            <img 
                            src={urlFor(secondaryPost2.image)
                                // .width(800)
                                // .height(500)
                                .auto('format')
                                .url()
                                } 
                            alt={secondaryPost2.image.alt || secondaryPost2.title}
                            loading="lazy"
                            />
                        ) : (
                            <span>{secondaryPost2.title}</span>
                        )}
                    </a>
                    <span class="tag tag-tech">{secondaryPost2.categories?.[0]}</span>
                    <a href={`/${secondaryPost2.slug.current}`}><div class="secondary-title">{secondaryPost2.title}</div></a>
                    <div class="card-meta">
                        <span>{naturalDate(secondaryPost2.date)}</span>
                        <span>{getReadingTime(secondaryPost2.content)} min read</span>
                    </div>
                </div>
                )}
            </div>
        </div>
    </section>
    <!-- /HERO -->

    <!-- AD SLOT -->
    <div class="container">
        <div class="ad-slot"><span>Advertisement</span></div>
    </div>

    <!-- LATEST NEWS + SIDEBAR -->
    <div class="container">
        <div class="content-layout">
            <div class="main-col">
                <!-- LATEST NEWS -->
                <div class="section-header">
                    <div class="section-neon-dot"></div>
                    <h2 class="section-title">Latest News</h2>
                    <div class="section-line"></div>
                    <a href="#" class="section-more">All News →</a>
                </div>
                <!-- Se utiliza la variable latestNews, que contiene 6 de los últimos posts más recientes (si existen) excluyendo aquellos
                que están en el hero. -->
                <div class="card-grid">
                    <div class="card">
                        {latestNews.map((post: any) => (
                        <a href={`/${post.slug.current}`} class="img-placeholder card-img">
                            {post.image ? (
                                <img 
                                src={urlFor(post.image)
                                    // .width(800)
                                    // .height(500)
                                    .auto('format')
                                    .url()
                                    } 
                                alt={post.image.alt || post.title}
                                loading="lazy"
                                />
                            ) : (
                                <span>{post.title}</span>
                            )}
                        </a>
                        <div class="card-body">
                            <span class="tag tag-series">{post.categories}</span>
                            <a href={`/${post.slug.current}`}><div class="card-title">{post.title}</div></a>
                            <div class="card-excerpt">
                                {post.summary}
                            </div>
                            <div class="card-meta">
                            <span>{naturalDate(post.date)}</span>
                            <span>{getReadingTime(post.content)} min read</span>
                            </div>
                        </div>
                        ))}
                    </div>
                </div>

                <!-- AD SLOT -->
                <div class="ad-slot">
                    <span>Advertisement</span>
                </div>

                <!-- SERIES SECTION -->
                <div class="section-header">
                    <div class="section-neon-dot"></div>
                    <h2 class="section-title">Series Deep Dives</h2>
                    <div class="section-line"></div>
                    <a href="#" class="section-more">All Series →</a>
                </div>
                <div class="horizontal-scroll">
                    <div class="card">
                        <div class="img-placeholder card-img">HOTD</div>
                        <div class="card-body">
                            <span class="tag tag-series"
                                >House of the Dragon</span
                            >
                            <div class="card-title">
                                Every Dragon Confirmed Alive Heading Into Season
                                3 — and Who Controls Each One
                            </div>
                            <div class="card-meta">
                                <span>June 7</span><span>8 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">EUPHO</div>
                        <div class="card-body">
                            <span class="tag tag-series">Euphoria</span>
                            <div class="card-title">
                                Rue's Final Arc in Season 3 Was Hidden in Plain
                                Sight Since Episode One
                            </div>
                            <div class="card-meta">
                                <span>June 6</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">DARE</div>
                        <div class="card-body">
                            <span class="tag tag-series">Daredevil</span>
                            <div class="card-title">
                                Why Kingpin's Return in Born Again Changes
                                Everything We Thought We Knew
                            </div>
                            <div class="card-meta">
                                <span>June 5</span><span>6 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">BOYS</div>
                        <div class="card-body">
                            <span class="tag tag-series">The Boys</span>
                            <div class="card-title">
                                The Boys Season 5: Is This Really the End of
                                Homelander?
                            </div>
                            <div class="card-meta">
                                <span>June 4</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ANIME SECTION -->
                <div class="section-header" style="margin-top:40px;">
                    <div
                        class="section-neon-dot"
                        style="background:var(--purple); box-shadow: 0 0 18px #aa55ff99;"
                    >
                    </div>
                    <h2 class="section-title" style="color:var(--purple);">
                        Anime
                    </h2>
                    <div
                        class="section-line"
                        style="background:linear-gradient(to right, var(--purple), transparent);"
                    >
                    </div>
                    <a
                        href="#"
                        class="section-more"
                        style="color:var(--purple); border-color:#6633aa;"
                        >All Anime →</a
                    >
                </div>
                <div class="horizontal-scroll">
                    <div class="card">
                        <div class="img-placeholder card-img">JJK</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Jujutsu Kaisen</span>
                            <div class="card-title">
                                The Real Reason Gojo's Death Hit Harder Than Any
                                Other in Shonen History
                            </div>
                            <div class="card-meta">
                                <span>June 7</span><span>5 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">AOT</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Attack on Titan</span>
                            <div class="card-title">
                                Eren's Plan Explained: Why the Rumbling Was
                                Actually the Only Option Left
                            </div>
                            <div class="card-meta">
                                <span>June 6</span><span>7 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">CSM</div>
                        <div class="card-body">
                            <span class="tag tag-anime">Chainsaw Man</span>
                            <div class="card-title">
                                Part 2's Most Disturbing Chapter Yet — and Why
                                It's Actually Genius
                            </div>
                            <div class="card-meta">
                                <span>June 5</span><span>4 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="img-placeholder card-img">OP</div>
                        <div class="card-body">
                            <span class="tag tag-anime">One Piece</span>
                            <div class="card-title">
                                Shanks' True Power Level Finally Revealed —
                                Elbaf Delivers the Moment Fans Waited 25 Years
                                For
                            </div>
                            <div class="card-meta">
                                <span>June 4</span><span>6 min</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIDEBAR -->
            <aside class="sidebar">
                <TelegramWG telegramUrl="https://t.me/tu_canal" />
                <Trending />
                <YoutubeWG channel="angeluseries" channelId="UCuuBBKR7pif5qztO911Jzmg" />
                <YoutubeWG channel="weyabu" channelId="UCNfVcg3KfUq4c_WA529qWZg" />
                <DealsWG />
            </aside>
        </div>
    </div>
    <Deals />
</main>