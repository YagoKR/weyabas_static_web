---
import telegramIcon from "../assets/socials/500px-Telegram.png";

interface Props {
  telegramUrl: string;
}

const { telegramUrl } = Astro.props;
---

<!-- TELEGRAM CTA -->
<div class="telegram-cta">
  <div class="telegram-icon"><img src={telegramIcon.src} /></div>
  <h3>Daily Deals on Telegram</h3>
  <p>
    Streaming sticks, anime figures, headphones & more — only the best
    discounts, curated daily.
  </p>
  <a href={telegramUrl} class="btn-telegram" target="_blank" rel="noopener"
    >JOIN FREE CHANNEL</a
  >
</div>
