---
import { client } from '../lib/sanity';

const { pathname } = Astro.url;

const isActive = (path: string) => {
  if (path === "/") return pathname === "/";
  return pathname.startsWith(path);
};

// 1. Obtenemos las últimas noticias con slug definido
const breakingNews = await client.fetch(`
  *[_type == "posts" && defined(slug.current)] | order(date desc)[0..2] {
    _id,
    title,
    "slug": slug.current
  }
`);

// Multiplicamos el array si hay muy pocas noticias para asegurarnos de llenar la pantalla
const baseItems = breakingNews.length > 0 ? breakingNews : [
  { title: "Bienvenido a Weyalu Series — Toda la actualidad", slug: "#" }
];

// Si hay menos de 4 noticias, las duplicamos en el grupo base para asegurar densidad
const listItems = baseItems.length < 4 ? [...baseItems, ...baseItems] : baseItems;
---
<header>
<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-inner">
    <div class="topbar-ticker-wrapper">
      <div class="topbar-ticker">
        
        <!-- BLOQUE 1 -->
        <div class="ticker-group">
          {listItems.map((post: any) => (
            <div class="ticker-item">
              <span class="ticker-dot">●</span>
              <a href={`/${post.slug}`}>{post.title}</a>
            </div>
          ))}
        </div>

        <!-- BLOQUE 2 (Copia idéntica para bucle fluido) -->
        <div class="ticker-group" aria-hidden="true">
          {listItems.map((post: any) => (
            <div class="ticker-item">
              <span class="ticker-dot">●</span>
              <a href={`/${post.slug}`}>{post.title}</a>
            </div>
          ))}
        </div>

      </div>
    </div>
    <div class="topbar-right">
      <a href="#">Newsletter</a>
      <a href="#">Telegram</a>
      <a href="#">YouTube</a>
    </div>
  </div>
</div>

<!-- HEADER -->

  <div class="header-inner">
    <div>
      <div class="logo">
        <a href="/">
          <span class="logo-w">Weyalu</span><span class="logo-accent">series</span>
        </a>
      </div>
      <div class="logo-sub">Series · Anime · Tech · Deals</div>
    </div>

    <nav>
      <a href="/" class={`nav-link ${isActive("/") ? "active" : ""}`}>News</a>
      <a href="/category/series" class={`nav-link ${isActive("/category/series") ? "active" : ""}`}>Series</a>
      <a href="/category/anime" class={`nav-link ${isActive("/category/anime") ? "active" : ""}`}>Anime</a>
      <a href="/category/movies" class={`nav-link ${isActive("/category/movies") ? "active" : ""}`}>Movies</a>
      <a href="/category/tech" class={`nav-link ${isActive("/category/tech") ? "active" : ""}`}>Tech</a>
      <a href="/category/theories" class={`nav-link ${isActive("/category/theories") ? "active" : ""}`}>Theories</a>
      <a href="#" class="nav-link nav-deals">🔥 Deals</a>
    </nav>

    {/* BUSCADOR CONECTADO A /search */}
    <form action="/search" method="GET" class="header-search">
      <span class="search-icon">🔍</span>
      <input 
        type="text" 
        name="q" 
        placeholder="Search series, anime, tech…" 
        required
        autocomplete="off"
      />
    </form>
  </div>
</header>