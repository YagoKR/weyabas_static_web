<style is:global>
  /* BEGIN GLOBAL PAGE STYLE */
  :root {
    /* Fondos */
    --bg: #0a0a0f;
    --bg2: #11111a;
    --bg3: #181824;
    --bg4: #47474d;

    --border: #1e1e2e;

    /* Tags */

    /* 
    Importante!

    Cuando se aplica el estilo CSS a un tag, se deriva la clase CSS del componente
    en base a la lista de categorias definidas en el schema (posts.ts). De manera que:
      - Si en posts.ts hay una categoria llamada con valor "xyz", la clase CSS 
      DEBE LLAMARSE NECESARIAMENTE --tag-xyz para que el estilo aplique correctamente. 
    */
    --tag-series: #005c8a;
    --tag-anime: #7a0092;
    --tag-movies: #946000;
    --tag-tech: #008d47;
    --tag-theories: #ff978f;

    /* Colores */
    --neon: #00aaff;
    --neon-dim: #0066cc;
    --neon-glow: 0 0 18px #00aaff55;
    --neon-glow-strong: 0 0 4px #00aaff99;

    --text-primary: #e8e8f0;
    --text-secondary: #9393b3;
    --text-muted: #6e6e99;

    --red: #ff3355;
    --green: #00ff88;
    --purple: #aa55ff;
    --orange: #ff8800;
    --white: #e6eefd;

    /* Font Sizes */
    --extralarge: 2.5rem;
    --large: 2rem;
    --medium: 1.5rem;
    --small: 1rem;
    --extrasmall: 0.85rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: var(--small);
  }

  body {
    background: var(--bg);
    color: var(--text-primary);
    font-family: "Inter", sans-serif;
    /* font-size: 15px; */
    line-height: 1.6;
    overflow-x: hidden;
  }

  a {
    color: var(--neon);
    text-decoration: none;
  }

  img {
    display: block;
    width: 100%;
  }

  /* Scanline textures are lowkey ugly as fudge on websites. Consider deleting. */

  /* ── SCANLINE TEXTURE ──
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
    z-index: 9999;
  } */

  /* END GLOBAL PAGE STYLE */

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* LOGO */

  /* .logo: controls the <div> tag that contains the logo of the site and the subtext that accompanies the logo.  */
  .logo {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: var(--extralarge);
    letter-spacing: -0.5px;
    text-transform: uppercase;
    line-height: 1;
  }

  /* .logo-w: controls the WEYALU part of the logo. */
  .logo-w {
    color: var(--text-primary);
    font-size: var(--large);
  }
  /* .logo-accent: controls the SERIES part of the logo. */
  .logo-accent {
    color: var(--neon);
    font-size: var(--large);
    text-shadow: var(--neon-glow-strong);
    position: relative;
  }
  /* .logo-sub: controls the text that goes under the logo. */
  .logo-sub {
    font-family: "JetBrains Mono", monospace;
    font-size: var(--extrasmall);
    color: var(--text-muted);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* HEADER */

  /* .header-search: controls the search form. */
  .header-search {
    display: flex;
    align-items: center;
    background: var(--bg3);
    border: 1px solid var(--bg4);
    border-radius: 0.5rem;
    padding: 0.4rem 0.8rem;
  }

  /* .header-search input: controls the input area of the search form. */
  .header-search input {
    background: none;
    border: none;
    outline: none;
    margin-left: 1em;
    color: var(--text-primary);
    font-size: var(--small);
    font-family: "Inter", sans-serif;
  }

  /* .header-search:focus-within: controls how the search box should display when the user clicks on it. */
  .header-search:focus-within {
    border-color: var(--neon);
    box-shadow: var(--neon-glow);
  }

  /* .search-icon: controls the icon shown next to the input. */
  .search-icon {
    color: var(--text-muted);
    font-size: var(--small);
  }

  /* .header-search input::placeholder: controls the way the placeholder text on the input form should display. */
  .header-search input::placeholder {
    color: var(--text-secondary);
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* BREAKING NEWS */

  /* The .breaking-* classes are very inconsistent. It seems the "ticker" classes control most of the styles. */

  /* .breaking-label: does not work. The label no longer appears. Consider deleting or reimplementing. */

  /* .breaking-label {
  position: absolute;
  left: 0; top: 0; bottom: 0;
    background: var(--red);
    display: flex;
    align-items: center;
    padding: 0 16px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: var(--verysmall);
    letter-spacing: 2px;
    color: #fff;
    z-index: 2;
    } 
  */

  /* Legacy code: consider deletion. */

  /* .breaking-scroll a::before {
    content: '◆';
    margin-right: 40px;
    opacity: 0.5;
    } 
  */

  .breaking-bar {
    background: var(--neon);
    padding: 8px 0;
    overflow: hidden;
    position: relative;
  }

  .breaking-scroll {
    display: flex;
    animation: ticker 30s linear infinite;
    white-space: nowrap;
    padding-left: 120px;
  }

  .breaking-item {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    font-size: var(--extralarge);
    color: var(--bg);
    padding: 0 40px;
  }

  @keyframes ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ==========================================
  ANIMACIÓN TICKER ESTILO NOTICIERO (CONTINUO)
  ========================================== */

  /* .topbar-ticker: controls the div that contains the breaking news tickers. */
  .topbar-ticker {
    display: flex;
    align-items: center;
    width: max-content; /* Clave para calcular exactamente el 100% del contenido duplicado */
    animation: ticker-slide 25s linear infinite; /* Ajusta la velocidad si lo deseas */
  }

  /* .topbar-ticker-wrapper: also controls a div that contains the breaking news tickers... */
  .topbar-ticker-wrapper {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
  }

  /* .topbar-ticker-wrapper:hover .topbar-ticker: controls the behavior of the animation when the user hovers over an item. */
  .topbar-ticker-wrapper:hover .topbar-ticker {
    animation-play-state: paused;
  }

  /* .ticker-group: groups items to make sure they loop perfectly. */
  .ticker-group {
    display: flex;
    align-items: center;
    gap: 2rem; /* Espaciado entre elementos */
    padding-right: 2rem; /* IMPORTANTE: Mismo valor que el gap para mantener la cadencia */
  }

  /* .ticker-item: contains each news item that is shown, including the dot that appears with it. */
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    white-space: nowrap; /* Fuerza a que todo el título quede en 1 sola línea */
  }

  /* .ticker-item a: controls the color of the items that appear in the breaking news section. */
  .ticker-item a {
    color: var(--text-secondary);
    font-size: var(--verysmall);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* .ticker-item a:hover: controls how the link on the breaking news slider should display when hovering over it. */
  .ticker-item a:hover {
    color: var(--neon);
  }

  /* .ticker-dot: displays how the circle next to the link on the breaking news slider should display. */
  .ticker-dot {
    color: var(--neon);
    font-size: var(--verysmall);
  }

  /* @keyframes ticker-slide: continuous sliding without visual jumps. It's kinda broken, because it only works fairly nicely
  when you space them by 2rem... You cannot change the gap values without making it fubar. */
  @keyframes ticker-slide {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* NAV */

  /* nav: self explanatory. The nav element contains all of the nav items. */
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--extrasmall);
    align-items: center;
  }

  /* .nav-link: controls the style of nav links when unhovered. */
  .nav-link {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    font-size: var(--small);
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 4px;
    color: var(--text-muted);
    transition:
      color 0.2s,
      background 0.2s;
    transition: font-size 0.2s;
    position: relative;
  }
  /* .nav-link:hover: controls the style and behavior of nav links when hovered. */
  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg3);
    font-size: var(--medium);
    transition: font-size 0.2s;
  }

  /* .nav-link.active: controls how the nav link should look like when the user is on the page. */
  .nav-link.active {
    color: var(--neon);
  }

  /* .nav-link.active::after: this is how we display the underline under the current page link. */
  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 14px;
    right: 14px;
    height: 0.2rem;
    background: var(--neon);
    border-radius: 2px;
  }

  /* .nav-deals: controls how the deals item should display. */
  .nav-deals {
    background: var(--neon);
    color: var(--bg);
    font-weight: 700;
  }

  /* .nav-deals:hover: controls how the deals element should display when hovering over it. */
  .nav-deals:hover {
    background: var(--orange);
    color: var(--bg);
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* LAYOUT */
  /* .container: this class is used in multiple points. It is used to contain the news grids, deals widget and advertisement slot placement. */
  .container {
    width: 100%;
    /* Ancho estándar para dashboards/noticias. Mejor usar la medida "vw" en la anchura para que se adapte a la ventana del usuario. */
    max-width: 90vw;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* HERO */

  /* .hero: contains the hero elements. Three news cards that show the latest news. */
  .hero {
    padding: 1vh 0 1vh;
  }

  /* .hero-grid: controls the grid elements. It creates two columns. The main hero element goes on the left. */
  .hero-grid {
    display: grid;
    grid-template-columns: 75% 25%;
    grid-template-rows: auto auto;
    /* La separacion entre las cards */
    gap: 1%;
  }

  /* .hero-main: controls the main element of the hero. It spans across both rows of the grid, starting at grid row line 1 (the top)
  and ending at grid row line 3 (the bottom of the second row). */
  .hero-main {
    grid-row: 1 / 3;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  /* .hero-main-img: controls the image that the main hero element uses. */
  .hero-main-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
    filter: brightness(0.9);
    transition:
      filter 0.3s,
      transform 0.4s;
  }

  /* .hero-main:hover .hero-main-img: controls the transition that occurs when you hover over the card. */
  .hero-main:hover .hero-main-img {
    filter: brightness(1);
    transform: scale(1.02);
  }

  /* .hero-main-content: controls the data that is shown under the main card. 
  Things like the title, the author, the tag, the date, the read time, etc. */
  .hero-main-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      transparent 100%
    );
  }

  /* .hero-secondary: this class contains the secondary hero elements.  Unlike the main card, here you can control things such as 
  the background color of the card.*/
  .hero-secondary {
    background: var(--bg2);
    padding: 20px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }

  /* .hero-secondary:hover: controls the behavior of the secondary hero elements when you hover over them. */
  .hero-secondary:hover {
    background: var(--bg3);
  }

  /* .hero-secondary-img: controls the images used in secondary hero elements. */
  .hero-secondary-img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    margin-bottom: 14px;
    filter: brightness(0.7);
  }
  /* .hero-title: controls the title of the main hero element. Gives it a shadow to distinguish it from the image and has more 
font-weight to emphasize the content.  */
  .hero-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: var(--extralarge);
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: var(--white);
    margin-bottom: 10px;
    text-shadow: 0px 0px 5px #0a0a0f;
  }

  /* .hero-title:hover: this controls the hovering behavior for the main hero element's title. Secondary titles have their own class. */
  .hero-title:hover {
    color: var(--neon);
  }

  /* .hero-title:hover: this controls the metadata for the main hero element specifically. Things such as date, author, read time, etc. */
  .hero-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: var(--small);
    color: var(--text-muted);
    display: flex;
    gap: 16px;
    align-items: center;
  }

  /* .hero-meta .dot: controls the diamond shaped dot that separates the metadata for the main hero element.  */
  .hero-meta .dot {
    color: var(--neon);
  }

  /* .secondary-title: this controls the secondary hero elements' titles. The main element's title has its own class. */
  .secondary-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: var(--medium);
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  /* .hero-secondary:hover: controls the hovering behavior for secondary elements' titles.  */
  .hero-secondary:hover .secondary-title {
    color: var(--neon);
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* TAGS */

  /* .tag: controls the general appearance of all tags. */
  .tag {
    display: inline-block;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: var(--small);
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 3px;
    margin: 0.5rem 0rem 0rem 0rem;
  }

  /* .tag-series: controls the background color for the series tag. */
  .tag-series {
    background: var(--tag-series);
    color: #fff;
  }

  /* .tag-anime: controls the background color for the anime tag. */
  .tag-anime {
    background: var(--tag-anime);
    color: #fff;
  }

  /* .tag-tech: controls the background color for the tech tag. */
  .tag-tech {
    background: var(--tag-tech);
    color: #fff;
  }

  /* .tag-movies: controls the background color for the movies tag. */
  .tag-movies {
    background: var(--tag-movies);
    color: #fff;
  }

  /* .tag-theories: controls the background color for the theories tag. */
  .tag-theories {
    background: var(--tag-movies);
    color: #fff;
  }

  /* --------------------------------------------------------------------------------------------------------------------------------- */
  /* --------------------------------------------------------------------------------------------------------------------------------- */

  /* ── SECTION HEADER ── */
  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 22px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--neon), transparent);
  }
  .section-neon-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: var(--neon-glow-strong);
    flex-shrink: 0;
  }
  .section-more {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--neon);
    letter-spacing: 1px;
    border: 1px solid var(--neon-dim);
    padding: 4px 12px;
    border-radius: 3px;
    transition: background 0.2s;
  }
  .section-more:hover {
    background: var(--bg3);
  }

  /* ── MAIN CONTENT GRID ── */
  .content-layout {
    display: grid;
    grid-template-columns: 75% 25%;
    gap: 1%;
    padding-bottom: 48px;
  }

  /* ── ARTICLE CARDS ── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--bg2);
  }
  .card {
    background: var(--bg2);
    cursor: pointer;
    transition: background 0.2s;
    overflow: hidden;
  }
  .card:hover {
    background: var(--bg3);
  }

  .card-img {
    display: inline-block;
    margin: 10px 0px 0px;

    /* width: 100%;
    height: 160px;
    object-fit: cover; */
    filter: brightness(0.75);
    transition:
      filter 0.3s,
      transform 0.3s;
  }
  .card:hover .card-img {
    filter: brightness(0.9);
    transform: scale(1.03);
  }
  .card-body {
    padding: 16px;
  }
  .card-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 8px;
    transition: color 0.2s;
  }
  .card:hover .card-title {
    color: var(--neon);
  }
  .card-excerpt {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: var(--small);
    color: var(--text-secondary);
    display: flex;
    gap: 12px;
  }

  /* ── LIST CARD (sidebar style) ── */
  .list-card {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.2s;
  }
  .list-card:last-child {
    border-bottom: none;
  }
  .list-card-img {
    width: 90px;
    height: 65px;
    object-fit: cover;
    flex-shrink: 0;
    filter: brightness(0.75);
    transition: filter 0.2s;
  }
  .list-card:hover .list-card-img {
    filter: brightness(0.9);
  }
  .list-card-body {
    flex: 1;
  }
  .list-card-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 6px;
    transition: color 0.2s;
  }
  .list-card:hover .list-card-title {
    color: var(--neon);
  }
  .list-card-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--text-secondary);
  }

  /* ── SIDEBAR ── */
  .sidebar {
  }

  .sidebar-widget {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-top: 2px solid var(--neon);
    margin-bottom: 24px;
    padding: 20px;
  }
  .widget-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--neon);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .widget-title::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--neon);
    box-shadow: var(--neon-glow);
    border-radius: 50%;
  }

  /* Trending widget */
  .trending-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }
  .trending-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .trending-num {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 28px;
    line-height: 1;
    color: var(--border);
    width: 32px;
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .trending-item:hover .trending-num {
    color: var(--neon);
    text-shadow: var(--neon-glow);
  }
  .trending-text {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .trending-item:hover .trending-text {
    color: var(--text-primary);
  }

  /* Telegram CTA */
  .telegram-cta {
    background: linear-gradient(135deg, #0a1a2e 0%, #0a0a1a 100%);
    border: 1px solid var(--neon-dim);
    padding: 24px;
    text-align: center;
    margin-bottom: 24px;
  }

  .telegram-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%; /* Ensures it spans the container to center within */
  }

  .telegram-icon img {
    width: 40%;
    height: auto;
    margin-bottom: 12px;
  }

  .telegram-cta h3 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }
  .telegram-cta p {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .btn-telegram {
    display: block;
    background: var(--neon);
    color: var(--bg);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px;
    border-radius: 4px;
    transition:
      background 0.2s,
      box-shadow 0.2s;
  }

  .btn-telegram:hover {
    background: #33bbff;
    box-shadow: var(--neon-glow-strong);
  }

  /* Deal card */
  .deal-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    padding: 14px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: border-color 0.2s;
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .deal-card:hover {
    border-color: var(--orange);
  }
  .deal-img-wrap {
    width: 70px;
    height: 70px;
    flex-shrink: 0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    font-size: 28px;
  }
  .deal-info {
    flex: 1;
  }
  .deal-name {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .deal-price-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .deal-price {
    font-family: "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: 600;
    color: var(--orange);
  }
  .deal-orig {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: line-through;
  }
  .deal-badge {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 11px;
    background: var(--red);
    color: #fff;
    padding: 2px 8px;
    border-radius: 3px;
    margin-left: auto;
  }

  /* YouTube embed area */
  .yt-widget {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-top: 2px solid var(--red);
    margin-bottom: 24px;
    overflow: hidden;
  }

  .yt-header {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }

  .yt-icon {
    color: var(--red);
    font-size: 18px;
  }

  .yt-header img {
    width: 10%;
    height: auto;
    margin-right: 10%;
  }

  .yt-header-text {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .yt-thumb {
    position: relative;
    cursor: pointer;
    display: block;
  }

  .yt-thumb img {
    width: 100%;
    height: fit-content;
    object-fit: cover;
    filter: brightness(0.7);
    transition: filter 0.2s;
  }
  .yt-thumb:hover img {
    filter: brightness(0.9);
  }

  .yt-play {
    /* - 'top/left: 50%' ubica la esquina izquierda (0,0) del botón en el centro. 
   - 'translate(-50%, -50%)' lo mueve la mitad de su propio tamaño hacia arriba 
   y a la izquierda para que el CENTRO del botón quede perfectamente alineado. */
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* El index posiciona a este elemento por encima del thumbnail */
    z-index: 10;
    width: 48px;
    height: 48px;
    background: var(--red);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #fff;
    box-shadow: 0 0 20px rgba(255, 51, 85, 0.6);
    transition: transform 0.2s ease-out;
  }

  .yt-thumb:hover .yt-play {
    transform: translate(-50%, -50%) scale(1.2);
  }

  .yt-info {
    padding: 12px 16px;
  }
  .yt-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .yt-channel {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--text-muted);
  }

  /* ── CATEGORY SECTIONS ── */
  .cat-section {
    margin-bottom: 48px;
  }

  .horizontal-scroll {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: var(--border);
  }

  /* ── DEALS STRIP ── */
  .deals-strip {
    background: linear-gradient(135deg, #0a1000 0%, #0a0a0f 100%);
    border-top: 2px solid var(--orange);
    border-bottom: 1px solid var(--border);
    padding: 32px 0;
    margin-bottom: 0;
  }
  .deals-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .deals-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 26px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--orange);
  }
  .deals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .deal-full-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    padding: 20px;
    cursor: pointer;
    transition:
      border-color 0.2s,
      transform 0.2s;
    position: relative;
  }
  .deal-full-card:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }
  .deal-full-emoji {
    font-size: 32px;
    margin-bottom: 12px;
  }
  .deal-full-name {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .deal-full-price {
    font-family: "JetBrains Mono", monospace;
    font-size: 22px;
    font-weight: 600;
    color: var(--orange);
    margin-bottom: 4px;
  }
  .deal-full-orig {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-secondary);
    text-decoration: line-through;
    margin-bottom: 14px;
  }
  .deal-full-btn {
    display: block;
    background: var(--orange);
    color: #fff;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 10px;
    text-align: center;
    border-radius: 3px;
    transition: background 0.2s;
  }
  .deal-full-btn:hover {
    background: #ffaa33;
  }
  .deal-full-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--red);
    color: #fff;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 3px 10px;
    border-radius: 3px;
  }

  /* ── FAKE IMAGE PLACEHOLDERS ── */
  .img-placeholder {
    background: var(--bg3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-size: 28px;
    font-family: "Barlow Condensed", sans-serif;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ── AD SLOT ── */
  .ad-slot {
    background: var(--bg3);
    border: 1px dashed var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 90px;
    margin: 24px 0;
  }

  .ad-slot span {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-main {
      grid-row: auto;
    }
    .content-layout {
      grid-template-columns: 1fr;
    }
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .horizontal-scroll {
      grid-template-columns: repeat(2, 1fr);
    }
    .deals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .topbar-ticker {
      display: none;
    }
    .card-grid {
      grid-template-columns: 1fr;
    }
    .horizontal-scroll {
      grid-template-columns: 1fr;
    }
    .deals-grid {
      grid-template-columns: 1fr;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .hero-title {
      font-size: 26px;
    }
  }

  /* -- HEADER -- */
  .topbar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 6px 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-muted);
  }
  .topbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    /* padding: 0 24px; */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .topbar-ticker {
    display: flex;
    gap: 24px;
  }

  .topbar-right {
    display: flex;
    gap: 16px;
    padding: 0rem 0rem 0rem 1rem;
  }

  .topbar-right a {
    color: var(--neon);
    font-size: var(--extrasmall);
  }

  .topbar-right a:hover {
    color: var(--neon);
  }

  /* ── HEADER ── */
  header {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    /* padding: 1rem; */
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  /* -- FOOTER -- */
  footer {
    background: var(--bg2);
    border-top: 1px solid var(--border);
    padding: 48px 0 24px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-brand .logo {
    margin-bottom: 12px;
  }
  .footer-brand p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .footer-socials {
    display: flex;
    gap: 1rem;
  }
  .social-btn {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition:
      border-color 0.2s,
      background 0.2s;
    cursor: pointer;
  }

  .social-btn img {
    height: 2rem;
    width: auto;
    filter: brightness(0.7);
    transition: filter 0.5s;
  }

  .social-btn img:hover {
    width: auto;
    filter: brightness(1);
  }

  .footer-col h4 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--neon);
    margin-bottom: 16px;
  }
  .footer-col ul {
    list-style: none;
  }

  .footer-col a {
    font-size: 1.2rem;
    color: var(--text-muted);
    /* padding: 5px 0; */
    cursor: pointer;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-bottom p {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-secondary);
  }
  .footer-bottom span {
    color: var(--neon);
  }

  /* -- ARTICLES -- */

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
    padding: 32px 0 48px;
  }

  .breadcrumb {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-secondary);
    padding-top: 20px;
    margin-bottom: 4px;
  }
  .breadcrumb a:hover {
    color: var(--neon);
  }
  .breadcrumb .sep {
    margin: 0 6px;
    color: var(--text-secondary);
  }

  .article-header {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .article-title {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.5px;
    color: #fff;
    margin: 10px 0 16px;
  }
  .article-dek {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .article-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .article-meta .dot {
    color: var(--neon);
  }
  .article-meta strong {
    color: var(--text-primary);
  }

  .article-hero-img {
    height: 460px;
    margin-bottom: 8px;
    font-size: 14px;
    letter-spacing: 3px;
    color: #1e2e3e;
  }
  .article-hero-caption {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  /* Article body typography */
  .article-body {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .article-body p {
    font-size: 17px;
    color: var(--text-primary);
    line-height: 1.75;
    margin-bottom: 22px;
  }

  .article-body h2 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-size: 28px;
    letter-spacing: -0.3px;
    color: #fff;
    margin: 40px 0 18px;
  }
  .article-body h3 {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 21px;
    color: var(--neon);
    margin: 32px 0 14px;
  }
  .article-body strong {
    color: #fff;
  }
  .article-body a {
    color: var(--neon);
    border-bottom: 1px solid var(--neon-dim);
  }
  .article-body ul,
  .article-body ol {
    margin: 0 0 22px 22px;
    color: var(--text-primary);
    font-size: 17px;
    line-height: 1.75;
  }
  .article-body li {
    margin-bottom: 8px;
  }
  .article-body blockquote {
    border-left: 3px solid var(--neon);
    background: var(--bg2);
    padding: 18px 24px;
    margin: 0 0 28px;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.4;
    color: var(--text-primary);
  }
  .article-body figure {
    margin: 32px 0;
  }
  .article-body figure .img-placeholder {
    height: 340px;
    font-size: 12px;
  }
  .article-body figcaption {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 8px;
  }

  /* ==========================================
   ESTILOS DE LECTURA DEL ARTÍCULO ([...slug].astro)
   ========================================== */

  main {
    max-width: 800px; /* Ancho idóneo para lectura cómoda */
    margin: 2.5rem auto;
    padding: 0 1.5rem;
  }

  /* ENCABEZADO DEL POST */
  .article-header {
    margin-bottom: 2.5rem;
    text-align: left;
  }

  /* Ya existe esta clase. Deberia borrarse esto. */
  /* .tag-series {
  display: inline-block;
  background-color: rgba(0, 210, 255, 0.15);
  color: #00d2ff;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  padding: 0.35rem 0.8rem;
  border-radius: 6px;
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
} */

  .article-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.25;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .article-dek {
    font-size: 1.2rem;
    color: #9ca3af;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    font-weight: 4rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: #6b7280;
    border-top: 1px solid #1f2937;
    border-bottom: 1px solid #1f2937;
    padding: 0.8rem 0;
  }

  .article-meta strong {
    color: #d1d5db;
  }

  .article-meta .dot {
    font-size: 0.5rem;
    color: #00d2ff;
  }

  /* CUERPO DEL POST (Renderizado por PortableText) */
  .article-body {
    color: #e5e7eb;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .article-body p {
    margin-bottom: 1.5rem;
  }

  .article-body h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin: 2.5rem 0 1rem 0;
    font-weight: 700;
  }

  .article-body h3 {
    font-size: 1.4rem;
    color: #ffffff;
    margin: 2rem 0 0.8rem 0;
  }

  .article-body blockquote {
    border-left: 4px solid #00d2ff;
    background: #0d1117;
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #d1d5db;
    border-radius: 0 8px 8px 0;
  }

  .article-body ul,
  .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-body li {
    margin-bottom: 0.5rem;
  }

  .article-body img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
  }

  /* ==========================================
   ANCHO MÁXIMO GLOBAL DE LA WEB
   ========================================== */

  /* 1. El contenedor principal que envuelve las secciones */
  /* NOTA: se ha eliminado a .hero de aqui para que el ancho se alinee perfectamente en cada seccion del cuerpo. */
  main,
  .main-container,
  .latest-news-section {
    width: 100%;
    max-width: 1280px; /* Ancho estándar para dashboards/noticias */
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
  }

  /* 2. Corrección para la sección LATEST NEWS (Grilla de 3 columnas) */
  .latest-news-grid {
    display: grid;
    grid-template-columns: repeat(
      3,
      minmax(0, 1fr)
    ); /* Evita que el texto aplaste las columnas */
    gap: 1.5rem;
    width: 100%;
  }

  /* 3. Ajuste para que las tarjetas de las noticias se expandan */
  .news-card {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .news-card h3 {
    word-break: break-word; /* Evita desbordamientos raros de texto */
    line-height: 1.3;
  }

  /* Estilos para la imagen principal de la noticia */
  .article-hero-image {
    width: 100%;
    max-width: 850px; /* Limita el ancho del contenedor del post para que no ocupe toda la pantalla horizontal */
    margin: 1.5rem auto 2.5rem auto; /* Centrado */
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 9; /* Mantiene la relación de aspecto exacta de la imagen original */
  }

  .article-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-hero-figure {
    margin: 1.5rem auto 2rem auto;
    width: 100%;
    max-width: 700px;
    aspect-ratio: 16 / 9;
  }

  .article-hero-figure img {
    width: 100%;
    height: auto; /* Permite que la altura cambie según la proporción real */
    max-height: 400px;
    object-fit: contain; /* IMPORTANTE: Muestra la imagen completa sin recortar texto */
    border-radius: 8px;
    display: block;
  }

  /* Estilo para los créditos de la imagen */
  .image-caption {
    font-size: 1.5rem;
    color: #8a8f9d;
    margin-top: 0.5rem;
    text-align: center;
    font-style: italic;
  }

  .post-item {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
  }

  .post-image-link {
    flex-shrink: 0;
    width: 220px; /* Ancho fijo para la miniatura */
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    display: block;
  }

  .post-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .post-image-link:hover img {
    transform: scale(1.05);
  }

  .post-content {
    flex-grow: 1;
  }

  /* Ajuste responsive para móviles */
  @media (max-width: 600px) {
    .post-item {
      flex-direction: column;
    }
    .post-image-link {
      width: 100%;
    }
  }

  /* Página de resultados */
  .search-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    min-height: 60vh;
  }

  .search-header h1 {
    font-size: 2rem;
    color: #fff;
  }

  .search-subtitle {
    color: #8a8f9d;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .search-card {
    display: flex;
    gap: 1.5rem;
    background: var(--bg2, #12151e);
    padding: 1rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .search-card-image {
