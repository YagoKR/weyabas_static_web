---
const title = "Weyalu Series";
const description = "A site about movies, TV shows, etc.";
---
<style is:global>
  :root {
    --bg:        #0a0a0f;
    --bg2:       #11111a;
    --bg3:       #181824;
    --border:    #1e1e2e;
    --neon:      #00aaff;
    --neon-dim:  #0066cc;
    --neon-glow: 0 0 18px #00aaff55;
    --neon-glow-strong: 0 0 32px #00aaff99;
    --text:      #e8e8f0;
    --text-muted:#7a7a9a;
    --text-dim:  #4a4a6a;
    --red:       #ff3355;
    --green:     #00ff88;
    --purple:    #aa55ff;
    --orange:    #ff8800;
    --tag-bg:    #0a1a2a;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  a { color: inherit; text-decoration: none; }
  img { display: block; width: 100%; }
</style>

<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
		<meta name="generator" content={Astro.generator} />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description}/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>


