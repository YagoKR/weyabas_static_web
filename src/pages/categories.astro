---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Style from "../layouts/Style.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { client } from "../lib/sanity";

interface Post {
  _id: string;
  title: string;
  slug: string;
  date?: string;
  summary?: string;
  author?: string;
}

// Consulta sin el filtro $category
const seriesPosts = await client.fetch<Post[]>(
  `*[_type == "posts"] | order(date desc) {
    _id,
    title,
    "slug": slug.current,
    date,
    summary,
    author
  }`
);

// Agrupar posts por fecha
const groupedPosts = seriesPosts.reduce((acc: Record<string, Post[]>, post) => {
  const postDate = post.date ? new Date(post.date) : new Date();
  const dateKey = postDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

  if (!acc[dateKey]) acc[dateKey] = [];
  acc[dateKey].push(post);
  return acc;
}, {});
---

<Layout>
  <Style />
  <Header />

  <main class="series-container">
    <h1 class="page-title" style="text-transform: capitalize;">
      All News and Articles
    </h1>

    <section class="posts-grouped">
      {
        Object.keys(groupedPosts).length === 0 ? (
          <p class="no-posts">No articles available.</p>
        ) : (
          Object.entries(groupedPosts).map(([date, postsInDate]) => {
            const posts = postsInDate as Post[];
            return (
              <div class="date-group">
                <h2 class="date-title">{date}</h2>
                <div class="posts-list">
                  {posts.map((post) => (
                    <article class="post-item">
                      <a href={`/${post.slug}`}>
                        <h3>{post.title}</h3>
                      </a>
                      {post.summary && (
                        <p class="post-summary">{post.summary}</p>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            );
          })
        )
      }
    </section>
  </main>

  <Footer />
</Layout>