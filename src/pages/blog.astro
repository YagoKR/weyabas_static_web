---

import { getCollection, type CollectionEntry } from "astro:content";import Footer from "../components/Footer.astro";
import { sortPosts } from '../utils/sortPosts'
import Header from "../components/Header.astro";
import Style from "../layouts/Style.astro";
import Layout from "../layouts/Layout.astro";

// El nombre de la colección es lo que exportamos de content.config.ts
const posts = await getCollection("posts")

---
<Layout>
    <Style />
    <Header />
        <!-- Se accede a los valores de la coleccion de la siguiente manera -->
        {
            /* TODO: la idea es que los articulos esten agrupados por fecha. */
            sortedPosts.map(post => {
                console.log(post.data.date)
                return (
                <a href={`/blog/${post.id}`}>
                    <h2>{post.data.title}</h2>
                </a>
                );
            })
        }

        <!-- ARTICLE BODY -->
        <div class="article-body">

          <p>OPENING PARAGRAPH</p>

          <p>CONTEXT_PARAGRAPH — background the reader needs</p>

          <div class="ad-slot"><span>Advertisement</span></div>

          <h2>SUBHEAD_1</h2>
          <p>PARAGRAPH</p>
          <p>PARAGRAPH</p>

          <blockquote>PULL_QUOTE — short punchy line pulled from the analysis</blockquote>

          <p>PARAGRAPH</p>

          <figure>
            <div class="img-placeholder">SECONDARY_IMAGE_LABEL</div>
            <figcaption>IMAGE_CAPTION</figcaption>
          </figure>

          <h2>SUBHEAD_2</h2>
          <p>PARAGRAPH</p>

          <ul>
            <li>BULLET_POINT</li>
            <li>BULLET_POINT</li>
            <li>BULLET_POINT</li>
          </ul>

          <div class="ad-slot"><span>Advertisement</span></div>

          <h2>SUBHEAD_3 — e.g. "What This Means Going Forward"</h2>
          <p>CLOSING_PARAGRAPH — wrap-up / what to expect next</p>

        </div>
    <Footer />
</Layout>