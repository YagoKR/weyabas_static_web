          <p>PARAGRAPH</p>
          <p>PARAGRAPH</p>

          <blockquote>PULL_QUOTE — short punchy line pulled from the analysis</blockquote>

          <p>PARAGRAPH</p>

          <figure>
            <div class="img-placeholder">SECONDARY_IMAGE_LABEL</div>
            <figcaption>IMAGE_CAPTION</figcaption>
          </figure>

          <h2>SUBHEAD_2</h2>
          <p>PARAGRAPH</p>

          <ul>
            <li>BULLET_POINT</li>
