---
import Layout from "../../../layouts/Layout.astro";
import Style from "../../../layouts/Style.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { client } from "../../../lib/sanity";
import imageUrlBuilder from "@sanity/image-url";

const builder = imageUrlBuilder(client);
function urlFor(source: any) {
    return builder.image(source);
}

// 1. Extraemos dinámicamente la categoría de la URL
const { category } = Astro.params;

// Límite de noticias por página
const POSTS_PER_PAGE = 10;

interface Post {
    _id: string;
    title: string;
    slug: string;
    date?: string;
    summary?: string;
    author?: string;
    image?: any;
}

// 2. Contamos cuántos artículos existen en total en Sanity para esta categoría
const totalPosts = await client.fetch<number>(
    `count(*[_type == "posts" && $category in categories])`,
    { category },
);

const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 3. GROQ con interpolación directa [0...${POSTS_PER_PAGE}] para limitar correctamente los posts
const seriesPosts = await client.fetch<Post[]>(
    `*[_type == "posts" && $category in categories] | order(date desc) [0...${POSTS_PER_PAGE}] {
    _id,
    title,
    "slug": slug.current,
    date,
    summary,
    author,
    image
  }`,
    { category },
);

// 4. Agrupar los artículos por fecha
const groupedPosts = seriesPosts.reduce((acc: Record<string, Post[]>, post) => {
    const postDate = post.date ? new Date(post.date) : new Date();
    const dateKey = postDate.toLocaleDateString("es-ES", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
    if (!acc[dateKey]) acc[dateKey] = [];
    acc[dateKey].push(post);
    return acc;
}, {});
---

<Layout>
    <Style />
    <Header />

    <main class="series-container">
        <h1 class="page-title" style="text-transform: uppercase;">
            Latest in {category}
        </h1>

        <section class="posts-grouped">
            {
                Object.keys(groupedPosts).length === 0 ? (
                    <p class="no-posts">
                        No articles available for {category}.
                    </p>
                ) : (
                    Object.entries(groupedPosts).map(([date, postsInDate]) => {
                        const posts = postsInDate as Post[];
                        return (
                            <div class="date-group">
                                <h2 class="date-title">{date}</h2>
                                <div class="posts-list">
                                    {posts.map((post) => (
                                        <article class="post-item">
                                            {post.image && (
                                                <a
                                                    href={`/${post.slug}`}
                                                    class="post-image-link"
                                                >
                                                    <img
                                                        src={urlFor(post.image)
                                                            .width(600)
                                                            .height(338)
                                                            .quality(75)
                                                            .format("webp")
                                                            .fit("crop")
                                                            .url()}
                                                        alt={post.title}
                                                        loading="lazy"
                                                    />
                                                </a>
                                            )}
                                            <div class="post-content">
                                                <a href={`/${post.slug}`}>
                                                    <h3>{post.title}</h3>
                                                </a>
                                                {post.summary && (
                                                    <p class="post-summary">
                                                        {post.summary}
                                                    </p>
                                                )}
                                            </div>
                                        </article>
                                    ))}
                                </div>
                            </div>
                        );
                    })
                )
            }
        </section>

        <!-- Paginador para la Página 1 -->
        {
            totalPages > 1 && (
                <nav class="pagination">
                    <div class="page-numbers">
                        <a
                            href={`/category/${category}`}
                            class="page-number active"
                        >
                            1
                        </a>
                        {Array.from(
                            { length: totalPages - 1 },
                            (_, i) => i + 2,
                        ).map((num) => (
                            <a
                                href={`/category/${category}/${num}`}
                                class="page-number"
                            >
                                {num}
                            </a>
                        ))}
                    </div>

                    <a href={`/category/${category}/2`} class="page-btn">
                        Next »
                    </a>
                </nav>
            )
        }
    </main>

    <Footer />
</Layout>

