---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import Style from "../../../layouts/Style.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { client } from "../../../lib/sanity";
import imageUrlBuilder from "@sanity/image-url";

const builder = imageUrlBuilder(client);
function urlFor(source: any) {
    return builder.image(source);
}

const { category, page } = Astro.params;

const POSTS_PER_PAGE = 10; // Ajusta el número de artículos por página según necesidad
const currentPage = Number(page) || 1;

const start = (currentPage - 1) * POSTS_PER_PAGE;
const end = start + POSTS_PER_PAGE;

interface Post {
    _id: string;
    title: string;
    slug: string;
    date?: string;
    summary?: string;
    author?: string;
    image?: any;
}

// Contar posts usando la condición flexible de categoría
const totalPosts = await client.fetch<number>(
	`count(*[_type == "posts" && ($category in categories || $category in categories[].title || $category in categories[].slug.current || $category in categories[]->slug.current)])`,
	{ category }
);

const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// Traer posts inyectando directamente los valores de start y end en el rango [start...end]
const seriesPosts = await client.fetch<Post[]>(
	`*[_type == "posts" && ($category in categories || $category in categories[].title || $category in categories[].slug.current || $category in categories[]->slug.current)] | order(date desc) [${start}...${end}] {
    _id,
    title,
    "slug": slug.current,
    date,
    summary,
    author,
    image
  }`,
	{ category }
);

const groupedPosts = seriesPosts.reduce((acc: Record<string, Post[]>, post) => {
    const postDate = post.date ? new Date(post.date) : new Date();
    const dateKey = postDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
    if (!acc[dateKey]) acc[dateKey] = [];
    acc[dateKey].push(post);
    return acc;
}, {});

// Generar array de páginas dinámico con puntos suspensivos
const pages: (number | string)[] = [];
const delta = 1;

for (let i = 1; i <= totalPages; i++) {
    if (
        i === 1 ||
        i === totalPages ||
        (i >= currentPage - delta && i <= currentPage + delta)
    ) {
        pages.push(i);
    } else if (pages[pages.length - 1] !== "...") {
        pages.push("...");
    }
}
---

<Layout>
    <Style />
    <Header />

    <main class="series-container">
        <h1 class="page-title" style="text-transform: uppercase;">
            Latest in {category} - Page {currentPage}
        </h1>

        <section class="posts-grouped">
            {
                Object.keys(groupedPosts).length === 0 ? (
                    <p class="no-posts">
                        No more articles available on this page.
                    </p>
                ) : (
                    Object.entries(groupedPosts).map(([date, postsInDate]) => {
                        const posts = postsInDate as Post[];
                        return (
                            <div class="date-group">
                                <h2 class="date-title">{date}</h2>
                                <div class="posts-list">
                                    {posts.map((post) => (
                                        <article class="post-item">
                                            {post.image && (
                                                <a
                                                    href={`/${post.slug}`}
                                                    class="post-image-link"
                                                >
                                                    <img
                                                        src={urlFor(post.image)
                                                            .width(600)
                                                            .height(338)
                                                            .quality(75)
                                                            .format("webp")
                                                            .fit("crop")
                                                            .url()}
                                                        alt={post.title}
                                                        loading="lazy"
                                                    />
                                                </a>
                                            )}
                                            <div class="post-content">
                                                <a href={`/${post.slug}`}>
                                                    <h3>{post.title}</h3>
                                                </a>
                                                {post.summary && (
                                                    <p class="post-summary">
                                                        {post.summary}
                                                    </p>
                                                )}
                                            </div>
                                        </article>
                                    ))}
                                </div>
                            </div>
                        );
                    })
                )
            }
        </section>

        {
            totalPages > 1 && (
                <nav class="pagination">
                    <a
                        href={
                            currentPage === 2
                                ? `/category/${category}`
                                : `/category/${category}/${currentPage - 1}`
                        }
                        class="page-btn"
                    >
                        « Previous
                    </a>

                    <div class="page-numbers">
                        {pages.map((p) =>
                            p === "..." ? (
                                <span class="page-ellipsis">...</span>
                            ) : (
                                <a
                                    href={
                                        p === 1
                                            ? `/category/${category}`
                                            : `/category/${category}/${p}`
                                    }
                                    class={`page-number ${p === currentPage ? "active" : ""}`}
                                >
                                    {p}
                                </a>
                            ),
                        )}
                    </div>

                    {currentPage < totalPages && (
                        <a
                            href={`/category/${category}/${currentPage + 1}`}
                            class="page-btn"
                        >
                            Next »
                        </a>
                    )}
                </nav>
            )
        }
    </main>

    <Footer />
</Layout>