---
// [slug].astro

export const prerender = true;
import { PortableText } from "astro-portabletext";
import imageUrlBuilder from "@sanity/image-url";
import { getReadingTime } from "../utils/readingTime";
import { client } from "../lib/sanity";
import Layout from "../layouts/Layout.astro";
import Style from "../layouts/Style.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// --- FUNCIÓN REQUERIDA PARA RUTAS DINÁMICAS PRERENDERIZADAS ---
export async function getStaticPaths() {
  // Consultar Sanity para traer el slug de todos los artículos publicados
  const posts = await client.fetch<Array<{ slug: { current: string } }>>(
    `*[_type == "posts" && defined(slug.current)]{ slug }`
  );

  // Mapear los slugs para pasarlos como parámetros a Astro
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

// Inicializamos el creador de URLs de imágenes de Sanity
const builder = imageUrlBuilder(client);

function urlFor(source: any) {
  return builder.image(source);
}

// Obtenemos el slug de los parámetros de la URL
const { slug } = Astro.params;
const slugValue = Array.isArray(slug) ? slug[0] : slug;
// Consultamos Sanity para el post actual
const post = await client.fetch(
  `*[_type == "posts" && slug.current == $slug][0]`,
  { slug: slugValue },
);

console.log("SlugValue:", slugValue);
// Si la URL no existe en Sanity, redirigimos a 404
if (!post) {
  return Astro.redirect("/404");
}

const readingTime = post.content ? getReadingTime(post.content) : 1;

// Detectamos el campo de la imagen
const imageSource = post.mainImage || post.image;
---

<Layout>
  <Style />
  <Header />

  <main class="article-container">
    <div class="article-header">
      <span class="tag tag-series">
        {
          Array.isArray(post.categories)
            ? post.categories[0]
            : post.categories || "General"
        }
      </span>
      <h1 class="article-title">{post.title}</h1>
      <p class="article-dek">{post.summary}</p>

      <div class="article-meta">
        <span>by <strong>{post.author}</strong></span>
        <span class="dot">◆</span>
        <span>
          {post.date ? new Date(post.date).toLocaleDateString("en-US") : ""}
        </span>
        <span class="dot">◆</span>
        <span>{readingTime} min read</span>
      </div>
    </div>

    {/* IMAGEN PRINCIPAL CON PIE DE FOTO / CRÉDITOS */}

    {
      imageSource && (
        <figure class="article-hero-figure">
          <img
            src={urlFor(imageSource)
              .width(1000)
              .quality(75)
              .format("webp")
              .url()}
            alt={imageSource.alt || post.title}
          />
          {imageSource.caption && (
            <figcaption class="image-caption">{imageSource.caption}</figcaption>
          )}
        </figure>
      )
    }

    <div class="article-body">
      {post.content && <PortableText value={post.content} />}
    </div>
  </main>

  <Footer />
</Layout>

{/* Script para enviar vistas evitando Falso Positivo */}
<script is:inline define:vars={{ postId: post._id }}>
  if (postId) {
    // Clave única por artículo para este navegador
    const storageKey = `visited_post_${postId}`;

    // Solo ejecuta la petición si NO ha visitado este post en esta sesión
    if (!sessionStorage.getItem(storageKey)) {
      fetch(`/api/views/${postId}`, { method: "POST" })
        .then(() => {
          // Marca el artículo como visitado en la sesión
          sessionStorage.setItem(storageKey, "true");
        })
        .catch((err) => console.error("Error enviando visita:", err));
    }
  }
</script>
